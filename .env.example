# Copy this file to .env.local (never commit .env.local) and fill in only the
# capabilities you want to enable. Every value below is a placeholder.
#
# ── App ────────────────────────────────────────────────────────────────────────
# Public URL of this app (used for links and the optional provider-driven voice
# callback). Typed live mode works with http://localhost:3000.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase (https://supabase.com/dashboard → Project Settings → API) ─────────
# Legacy anon key still works; publishable key (sb_publishable_...) is preferred.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXXXXX
# Server-only. Never expose to the browser. Prefer secret key (sb_secret_...).
SUPABASE_SECRET_KEY=sb_secret_XXXXXXXX

# ── OpenAI (https://platform.openai.com/api-keys) ─────────────────────────────
OPENAI_API_KEY=sk-...
# Reasoning/turn model (default balanced model).
OPENAI_MODEL=gpt-6.1-sol
# Faster/cheaper model for evaluation + extraction.
OPENAI_MODEL_FAST=gpt-6-luna

# ── Avatar provider ────────────────────────────────────────────────────────────
# "heygen" = real-time HeyGen LiveAvatar FULL mode (video + synchronized speech).
#            Typed live mode requires only HEYGEN_API_KEY + HEYGEN_AVATAR_ID.
#            The candidate types each answer; SynergyAI generates the next
#            interviewer line server-side and the browser asks the avatar to
#            speak it with the documented avatar.speak_text command. No public
#            callback URL or OpenAI-compatible endpoint is needed.
#            If either value is missing, starting a live session fails with an
#            explicit configuration error (never a silent demo fallback, and
#            never a fake animated placeholder).
# "demo"   = built-in visual demo interviewer (static fictional portrait, typed
#            answers, optional browser speechSynthesis) — always labeled.
AVATAR_PROVIDER=demo
# HeyGen LiveAvatar API key (https://app.liveavatar.com/developers) — server-only.
HEYGEN_API_KEY=
# REQUIRED for heygen mode: avatar UUID from GET https://api.liveavatar.com/v1/avatars/public
# (send header X-API-KEY). Without it, starting a live session fails with a clear error.
# One avatar is used for every interviewer persona; choose its appearance accordingly.
HEYGEN_AVATAR_ID=

# ── Optional: provider-driven voice callback (not used by typed live mode) ─────
# Only needed if you wire LiveAvatar's custom-LLM voice mode. That mode requires
# a public HTTPS NEXT_PUBLIC_APP_URL so LiveAvatar can call:
#   ${NEXT_PUBLIC_APP_URL}/api/interviews/[id]/llm/chat/completions
# The shared secret derives per-session HMAC bearer tokens for that endpoint.
# Generate with: openssl rand -hex 32
LLM_SHARED_SECRET=

# ── Demo mode (no credentials required) ────────────────────────────────────────
# Force demo mode even if credentials exist (0/false to disable). When Supabase
# or OpenAI are missing, the app automatically degrades to labeled demo behavior.
# Demo access (signed cookie) is only honored when Supabase is NOT configured,
# unless NEXT_PUBLIC_DEMO_MODE forces it — real auth is never shadowed by demo.
NEXT_PUBLIC_DEMO_MODE=
# Secret for signing the demo-session cookie (any random string).
DEMO_SESSION_SECRET=dev-only-change-me
